{
  "id": "MOD_EUTRANINTRAFREQNCELL",
  "name": "MOD EUTRANINTRAFREQNCELL",
  "description": "Modify Intra-Frequency Neighboring Relation with E-UTRAN Cell",
  "template": "MOD EUTRANINTRAFREQNCELL: LocalCellId={LocalCellId}, Mcc=\"{Mcc}\", Mnc=\"{Mnc}\", eNodeBId={eNodeBId}, CellId={CellId}, CellIndividualOffset={CellIndividualOffset}, CellQoffset={CellQoffset}, NoHoFlag={NoHoFlag}, NoRmvFlag={NoRmvFlag};",
  "fields": [
    {
      "id": "LocalCellId",
      "label": "Local Cell ID",
      "type": "number",
      "min": 0,
      "max": 255,
      "default": "0"
    },
    {
      "id": "Mcc",
      "label": "MCC",
      "type": "text",
      "pattern": "^[0-9]{3}$",
      "default": "460",
      "hint": "3 digits"
    },
    {
      "id": "Mnc",
      "label": "MNC",
